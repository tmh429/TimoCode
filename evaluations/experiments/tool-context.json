{
  "schema_version": 1,
  "name": "tool-context",
  "tasks": [
    "../tasks/find-service-config",
    "../tasks/merge-intervals",
    "../tasks/chunk-list",
    "../tasks/config-timeout",
    "../tasks/test-safe-divide"
